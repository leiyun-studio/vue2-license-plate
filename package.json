{
  "name": "vue-license-plate",
  "description": "一款基于vue的车牌号输入控件",
  "license": "MIT",
  "keywords": [
    "car",
    "车牌号",
    "license plate"
  ],
  "version": "1.1.0",
  "main": "lib/licensePlate.common.js",
  "module": "lib/licensePlate.esm.mjs",
  "types": "index.d.ts",
  "unpkg": "lib/licensePlate.umd.min.js",
  "files": [
    "lib",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/licensePlate.esm.mjs",
      "require": "./lib/licensePlate.common.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leiyun-studio/vue2-license-plate.git"
  },
  "homepage": "https://github.com/leiyun-studio/vue2-license-plate#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "serve": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lib": "node scripts/build-lib.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:package": "node --test tests/package.test.cjs",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tests/tsconfig.json",
    "prepack": "npm run lint && npm test && npm run lib && npm run test:package && npm run typecheck"
  },
  "peerDependencies": {
    "vue": "~2.6.14 || ^2.7.16"
  },
  "devDependencies": {
    "vite": "^7.3.7",
    "@vitejs/plugin-vue2": "^2.3.4",
    "vue": "2.7.16",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
